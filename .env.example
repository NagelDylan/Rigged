# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Anthropic API key for the live RIG agent (server-side only, never sent to the browser).
# Leave empty to play against the deterministic local RIG.
ANTHROPIC_API_KEY=

# Optional overrides
# RIG_MODE=local                      # force the deterministic local RIG even if a key is set
# RIG_MODEL=claude-sonnet-5-5         # in-play tactical decisions (latency-sensitive)
# RIG_EFFORT=low
# RIG_PLANNER_MODEL=claude-opus-5-5   # final MODEL chamber plan + end-of-run memory (latency-hidden)
# RIG_PLANNER_EFFORT=low
# PORT=5173
# RIGGED_DB_PATH=data/rigged.db
